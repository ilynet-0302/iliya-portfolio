{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    ".vinext/**",
    ".vite/**",
    ".cache/**",
    "out/**",
    "build/**",
    "dist/**",
    "coverage/**",
    "*.tsbuildinfo",
    "next-env.d.ts",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb"
  ]
}
